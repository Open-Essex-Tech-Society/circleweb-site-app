{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "circleweb-site-app",
  "version": "0.1.0",
  "identifier": "com.tatsuya.circleweb-site-app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://openessex-circle-offcial-site.pages.dev",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "circleweb-site-app",
        "width": 800,
        "height": 600,
        "url": "openessex-circle-offcial-site.pages.dev"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
